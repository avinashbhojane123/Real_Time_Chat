# Server Configuration
PORT=10000
GLOBAL_PREFIX=api
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=realtime_chat
DB_SSL=false
DB_SYNCHRONIZE=true

# Upload Configuration
UPLOAD_DIR=uploads
UPLOAD_PREFIX=/uploads/
MAX_FILE_SIZE_MB=100

# Instagram Preview Configuration (Without Official API)
# Paste your Instagram sessionid cookie value here:
# (Inspect Instagram in browser -> Application / Storage -> Cookies -> https://www.instagram.com -> sessionid)
INSTAGRAM_SESSION_ID=

# Strix AI Security Pentesting & CI Scanning Configuration
# STRIX_API_TOKEN=your_strix_api_token_here
# STRIX_LLM=openai/gpt-4o
# LLM_API_KEY=your_llm_api_key_here
