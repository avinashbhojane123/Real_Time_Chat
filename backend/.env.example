# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=realtimechat

# Server Configuration
PORT=10000
NODE_ENV=development
ALLOWED_ORIGINS=*

# Render Server Keep-Alive Configuration
# Render automatically injects RENDER_EXTERNAL_URL in production (e.g. https://my-app.onrender.com)
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com

# Optional explicit ping URL override
PING_URL=https://your-app-name.onrender.com/api/keep-alive/ping

# Keep-Alive ping interval in minutes (default: 10)
KEEP_ALIVE_INTERVAL_MINUTES=10

# Set to 'true' to disable self-ping background timer
DISABLE_KEEP_ALIVE=false
