# Server Configuration
PORT=10000
GLOBAL_PREFIX=api
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (Supabase / PostgreSQL)
# Option 1: Supabase Connection String (Recommended)
# Get from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# - Mode: Session (port 5432) or Transaction (port 6543)
# Example: postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Option 2: Individual Supabase / DB parameters (if not using DATABASE_URL)
DB_TYPE=postgres
DB_HOST=
DB_PORT=6543
DB_USERNAME=
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SYNCHRONIZE=true

# Security & Session Authentication
SESSION_SECRET=nexus_chat_super_secure_signing_secret_2026

# Upload Configuration
UPLOAD_DIR=uploads
UPLOAD_PREFIX=/uploads/
MAX_FILE_SIZE_MB=100

# Instagram Preview Configuration (Without Official API)
# Paste your Instagram sessionid cookie value here:
# (Inspect Instagram in browser -> Application / Storage -> Cookies -> https://www.instagram.com -> sessionid)
INSTAGRAM_SESSION_ID=
